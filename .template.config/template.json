{
  "$schema": "http://json.schemastore.org/template",
  "author": "Hung",
  "classifications": [
    "Web",
    "ASP.NET Core"
  ],
  "identity": "Hung.CleanArchitecture.Template",
  "name": "Hung Clean Architecture API",
  "shortName": "basecode",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        ".template.config/**",
        "**/bin/**",
        "**/obj/**",
        "**/.git/**",
        "**/.idea/**",
        "**/*.user",
        "**/*.lock.json",
        "Template-config.md",
        "docs/**",
        ".template-tests/**"
      ]
    }
  ],
  "symbols": {
    "safeName": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "[^a-zA-Z0-9_.]",
            "replacement": "_"
          }
        ]
      },
      "replaces": "CodeBase",
      "fileRename": "CodeBase"
    }
  }
}
